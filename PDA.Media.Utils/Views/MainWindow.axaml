<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDA.Media.Utils.ViewModels"
        xmlns:logging="using:PDA.Media.Utils.Logging"
        xmlns:models="using:PDA.Media.Utils.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="PDA.Media.Utils.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="Inter" FontSize="14" FontWeight="SemiBold" 
        Title="PDA.Media.Utils">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="../Styles/MainWindowStyles.axaml"/>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,2*,*,Auto" ColumnDefinitions="*,*" ShowGridLines="False">
    
        <!-- Header: branding on the left; toolbar groups (queue | encoding | window) on the right. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Classes="HeaderPanel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

                <StackPanel Grid.Column="0" Classes="BrandArea">
                    <PathIcon Classes="Brand"/>
                    <StackPanel Classes="BrandText">
                        <TextBlock Text="{Binding BrandTitle}" Classes="BrandTitle"/>
                        <TextBlock Text="Encode MKV media for Plex" Classes="BrandSubtitle"/>
                    </StackPanel>
                </StackPanel>

                <!-- Queue and tools. -->
                <StackPanel Grid.Column="2" Classes="ToolbarGroup">
                    <Button Name="SendMediaItemsButton" Classes="Toolbar" ToolTip.Tip="Send source media items to destination"
                            Command="{Binding LoadDestinationItemsCommand}">
                        <PathIcon Data="{StaticResource copy_to_destination}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="ManageProfilesToolbarButton" Classes="Toolbar" ToolTip.Tip="Manage FFMpeg Encoding Profiles" Click="ManageProfilesButton_OnClick">
                        <PathIcon Data="{StaticResource sliders_icon}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="LoadColourPalette" Classes="Toolbar" ToolTip.Tip="Show Avalonia colours" Click="LoadColourPalette_OnClick">
                        <PathIcon Data="{StaticResource paint_roller}" Classes="Toolbar"/>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Classes="ToolbarSeparator"/>

                <!-- Encoding: start, cancel, and download FFmpeg (only shown while it's missing). -->
                <StackPanel Grid.Column="4" Classes="ToolbarGroup">
                    <Button Name="EncodeButton" Classes="Toolbar" ToolTip.Tip="Encode the destination list with the selected profile"
                            Command="{Binding EncodeCommand}">
                        <PathIcon Data="{StaticResource play_icon}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="CancelEncodeButton" Classes="Toolbar" ToolTip.Tip="Cancel encoding (the current file is discarded)"
                            Command="{Binding EncodeCancelCommand}">
                        <PathIcon Data="{StaticResource stop_icon}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="DownloadFFmpegButton" Classes="Toolbar" ToolTip.Tip="Download FFmpeg and FFprobe into the app's bin folder"
                            Command="{Binding DownloadFFmpegCommand}" IsVisible="{Binding !IsFFmpegAvailable}">
                        <PathIcon Data="{StaticResource download_icon}" Classes="Toolbar"/>
                    </Button>
                </StackPanel>

                <Border Grid.Column="5" Classes="ToolbarSeparator"/>

                <!-- Window buttons. -->
                <StackPanel Grid.Column="6" Classes="ToolbarGroup">
                    <Button Name="WindowMinimizeButton" Classes="Toolbar" ToolTip.Tip="Minimize Window" Click="WindowMinimizeButton_OnClick">
                        <PathIcon Data="{StaticResource window_minimize}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="WindowMaximizeButton" Classes="Toolbar" ToolTip.Tip="Maximize/Restore Window" Click="WindowMaximizeButton_OnClick">
                        <PathIcon Data="{StaticResource window_maximize}" Classes="Toolbar"/>
                    </Button>
                    <Button Name="WindowCloseButton" Classes="Toolbar" ToolTip.Tip="Close Window" Click="WindowCloseButton_OnClick">
                        <PathIcon Data="{StaticResource window_close}" Classes="Toolbar"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Source Folder / Files -->
        <Border Grid.Column="0" Grid.Row="1" Classes="SourcePanel">
            <Grid RowDefinitions="Auto,*">

                <!-- Source file label, data and button. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0" Content="Source:" Classes="PanelHeading"/>
                    <Border Grid.Column="1" Classes="PanelHeadingTextBox">
                        <SelectableTextBlock Text="{Binding SourcePath}" Classes="PanelHeading"/>
                    </Border>
                    <Button Grid.Column="2" Name="SelectSourceFolderButton" ToolTip.Tip="Select source folder" Classes="Toolbar" Click="SelectSourceFolderButton_OnClick">
                        <PathIcon Data="{StaticResource folder_open}" Classes="Toolbar"/>
                    </Button>
                </Grid>

                
                <!-- Source file/folder tree list. -->
                <TreeView Grid.Row="1" Name="sourceTreeView" ItemsSource="{Binding SourceMediaNodes}" Classes="SourceFiles" >
                    <!-- Folders: name and file count. Files: name followed by size, as in the destination list. -->
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="models:MediaNode" ItemsSource="{Binding SubNodes}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Classes="SourceSelect"/>
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Classes="SourceNameLine">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="SourceName" Classes.Folder="{Binding IsFolder}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" IsVisible="{Binding !IsFolder}" Classes="SourceDetail SourceSize"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding FileCountText}" IsVisible="{Binding IsFolder}" Classes="SourceDetail SourceFileCount"/>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
            </Grid>
        </Border>

        
        <!-- Destination Items -->
        <Border Grid.Column="1" Grid.Row="1"  Classes="DestinationPanel" >
            <Grid RowDefinitions="Auto,*">
                
                <!-- Destination selection box. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" >
                    <Label Grid.Column="0" Content="Destination:" Classes="PanelHeading"/>
                    <Border Grid.Column="1" Classes="PanelHeadingTextBox">
                        <SelectableTextBlock Grid.Column="1" Text="{Binding DestinationPath}" Classes="PanelHeading"/>
                    </Border>
                    <Button Grid.Column="2" Name="SelectDestinationFolderButton" ToolTip.Tip="Select destination folder" Classes="Toolbar" Click="SelectDestinationFolderButton_OnClick">
                        <PathIcon Data="{StaticResource folder_open}" Classes="Toolbar"/>
                    </Button>
                </Grid>
                
                <!-- Source file/folder list. -->
                <ListBox Grid.Row="1" Name="destinationListBox" Classes="DestinationFiles" 
                         ItemsSource="{Binding DestinationItems}" SelectedItem="{Binding SelectedDestinationItem}">
                    
                    <!-- Each item: Plex output name, source file, and encoding status. -->
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DestinationItem">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding OutputRelativePath}" Classes="DestinationOutput"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Classes="DestinationStatus"
                                           Classes.Encoding="{Binding IsEncoding}" Classes.Done="{Binding IsDone}"
                                           Classes.Skipped="{Binding IsSkipped}" Classes.Failed="{Binding IsFailed}"/>
                                <!-- Left-aligned so the size follows the path, which is trimmed when space runs out. -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Classes="DestinationSourceLine">
                                    <TextBlock Grid.Column="0" Text="{Binding FullPath}" Classes="DestinationSource"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SourceSizeText}" Classes="DestinationSource DestinationSize"/>
                                </Grid>
                                <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding Progress}" IsVisible="{Binding IsEncoding}"
                                             Classes="DestinationProgress"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    
                </ListBox>
               
            </Grid>
        </Border>

        
        <!-- FFMpeg Profile and Settings. -->
        <!-- ============================================================================================================================ -->
        <Border Grid.Column="0" Grid.Row="2" Classes="LeftPanel" >
            <Grid RowDefinitions="Auto,*" Margin="7">
                
                <!-- FFMpeg profile selector. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" >
                    <Label Grid.Column="0" Content="FFMpeg Profile:" Classes="PanelHeading"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EncoderProfiles}" SelectedItem="{Binding SelectedEncoderProfile, Mode=TwoWay}" Classes="ProfileSelector"/>
                    <Button Grid.Column="2" Name="AddFFMpegProfileButton" ToolTip.Tip="Manage FFMpeg encoding profiles" Classes="Toolbar" Click="ManageProfilesButton_OnClick">
                        <PathIcon Data="{StaticResource sliders_icon}" Classes="Toolbar"/>
                    </Button>
                </Grid>
                
                <!-- Profile details preview -->
                <Border Grid.Row="1" Classes="ProfilePanel">
                    <Grid RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding CurrentEncodeProfile, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Profile Details - First Line. -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding CurrentEncodeProfile.Description, FallbackValue=''}" Classes="ProfileLineOne"/>
                            <Border Grid.Column="1" Classes="ProfileTag">
                                <TextBlock Text="{Binding CurrentEncodeProfile.TargetCategory, FallbackValue=''}" Classes="ProfileTag"/>
                            </Border>
                        </Grid>

                        <!-- Profile Details - Second Line. -->
                        <!-- TODO: Really need to clean these styles up but it's all over so will leave for later. -->
                        <StackPanel Grid.Row="1" Classes="ProfileLineTwo">
                            <TextBlock Text="{Binding CurrentEncodeProfile.VideoCodec, StringFormat='Codec: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemBaseHighColor}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentEncodeProfile.Preset, StringFormat='Preset: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBlock Text="{Binding CurrentEncodeProfile.Crf, StringFormat='CRF: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentEncodeProfile.PixelFormat, StringFormat='PixFmt: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBlock Text="{Binding CurrentEncodeProfile.MinimumSourceFileSizeFormatted, StringFormat='Min Size: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                            <TextBlock Text="{Binding CurrentEncodeProfile.AudioCodec, StringFormat='Audio: {0}', FallbackValue=''}" FontSize="11" Foreground="{DynamicResource SystemBaseHighColor}"/>
                        </StackPanel>

                        <!-- Profile Details - Third Line. -->
                        <Border Grid.Row="2" Classes="ProfileCommandLine">
                            <SelectableTextBlock Text="{Binding CurrentEncodeProfile.GeneratedFFMpegArguments, FallbackValue=''}" Classes="ProfileCommandLine"/> 
                        </Border>
                        
                    </Grid>
                </Border>
            </Grid>
        </Border>

        
        <!-- Audit Log. -->
        <!-- ============================================================================================================================ -->
        <Border Grid.Column="1" Grid.Row="2" Classes="RightPanel" >
            <Grid RowDefinitions="Auto,*" Margin="7">

                <!-- Audit log header and actions. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Label Grid.Column="0" Content="Audit Log" Classes="PanelHeading"/>
                    <Button Grid.Column="2" Name="ClearLogButton" Classes="Toolbar" ToolTip.Tip="Clear the audit log panel (the log file is kept)" Command="{Binding ClearAuditLogCommand}">
                        <PathIcon Data="{StaticResource trash_icon}" Classes="Toolbar"/>
                    </Button>
                    <Button Grid.Column="3" Name="OpenLogButton" Classes="Toolbar" ToolTip.Tip="Open the full log file" Margin="5,0,0,0" Click="OpenLogButton_OnClick">
                        <PathIcon Data="{StaticResource file_lines_icon}" Classes="Toolbar"/>
                    </Button>
                    <Button Grid.Column="4" Name="SaveLogButton" Classes="Toolbar" ToolTip.Tip="Save a copy of the log to the Downloads folder" Margin="5,0,0,0" Click="SaveLogButton_OnClick">
                        <PathIcon Data="{StaticResource download_icon}" Classes="Toolbar"/>
                    </Button>
                </Grid>

                <!-- Live log entries (Information and above), newest at the bottom. -->
                <ListBox Grid.Row="1" Name="AuditLogListBox" Classes="AuditLog" ItemsSource="{Binding AuditLogEntries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="logging:AuditLogEntry">
                            <TextBlock Text="{Binding DisplayText}" 
                                       Classes="AuditLogEntry" Classes.Warning="{Binding IsWarning}" Classes.Error="{Binding IsError}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>
        
        <!-- Main Window Status Bar. -->
        <Border Name="mainWindowStatusBar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="StatusPanel" >
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="StatusText"/>
                <ProgressBar Grid.Column="1" Value="{Binding OverallProgress}" IsVisible="{Binding IsEncoding}" Classes="StatusProgress"/>
            </Grid>
        </Border>
        
        
    </Grid>

</Window>