<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDA.Media.Utils.ViewModels"
             xmlns:models="using:PDA.Media.Utils.Models"
             xmlns:scanner="using:PDA.Media.Scanner.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="640"
             x:Class="PDA.Media.Utils.Views.MediaSearchView"
             x:DataType="vm:MediaSearchViewModel">

    <UserControl.Styles>
        <StyleInclude Source="../Styles/MediaSearchViewStyles.axaml"/>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="420,12,*" Classes="SearchContent">

            <!-- Left: search, categories, filters and the results tree. -->
            <!-- ============================================================================================================== -->
            <Border Grid.Column="0" Classes="ContentPanel">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Classes="SearchBar">
                        <TextBox Grid.Column="0" Name="SearchTextBox" Text="{Binding SearchText}" Classes="SearchBox"
                                 PlaceholderText="Names, descriptions and notes (* for everything)">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Command="{Binding SearchCommand}" Classes="SearchButton accent"
                                ToolTip.Tip="Search the ticked categories (Enter). * is a wildcard: Abba* starts with Abba">
                            <StackPanel Classes="ButtonContent">
                                <PathIcon Data="{StaticResource scan_icon}" Classes="ButtonIcon"/>
                                <TextBlock Text="Search"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Categories in groups (Music, Video): a group's tick box ticks or clears everything in it. -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CategoryGroups}" Classes="SearchCategories">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchCategoryGroup">
                                <Grid ColumnDefinitions="80,*" Classes="SearchCategoryGroup">
                                    <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsSelected}" Classes="SearchCategoryGroup"
                                              ToolTip.Tip="Tick or clear every category in the group"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SearchCategoryItem">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding RootFolder}" Classes="SearchCategory"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Classes="SearchFilters">
                        <CheckBox Content="Favourites only" IsChecked="{Binding FavouritesOnly}"/>
                        <CheckBox Content="Show deleted" IsChecked="{Binding ShowDeleted}"
                                  ToolTip.Tip="Include rows a scan has soft-deleted (no longer in the media folders); shown greyed out"/>
                    </StackPanel>

                    <TreeView Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Classes="MediaTree">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="models:MediaTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="models:MediaTreeNode" ItemsSource="{Binding Children}">
                                <StackPanel Classes="NodeContent">
                                    <PathIcon Classes="NodeIcon" IsVisible="{Binding !IsMessage}"
                                              Classes.Group="{Binding IsGroup}" Classes.Artist="{Binding IsArtist}" Classes.Album="{Binding IsAlbum}"
                                              Classes.Track="{Binding IsTrack}" Classes.Source="{Binding IsSource}" Classes.Movie="{Binding IsMovie}"
                                              Classes.Show="{Binding IsShow}" Classes.Season="{Binding IsSeason}" Classes.Episode="{Binding IsEpisode}"/>
                                    <TextBlock Text="{Binding Title}" Classes="NodeTitle" Classes.Match="{Binding IsMatch}" Classes.Deleted="{Binding IsDeleted}"
                                               Classes.Message="{Binding IsMessage}" Classes.Group="{Binding IsGroup}"/>
                                    <TextBlock Text="{Binding Subtitle}" Classes="NodeSubtitle"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <PathIcon Data="{StaticResource star_icon}" Classes="Favourite" IsVisible="{Binding IsFavourite}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Classes="SearchStatus">
                        <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" IsIndeterminate="True" IsVisible="{Binding IsSearching}" Classes="Searching"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" Classes="SearchStatusText"/>
                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding TidyNamesInBranchCommand}" Classes="DetailsAction"
                                ToolTip.Tip="Suggest tidy names for everything in the selected branch, then rename the ones you tick">
                            <StackPanel Classes="ButtonContent">
                                <PathIcon Data="{StaticResource tidy_icon}" Classes="ButtonIcon"/>
                                <TextBlock Text="Tidy names..."/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: details and editing of the selected row. -->
            <!-- ============================================================================================================== -->
            <Border Grid.Column="2" Classes="ContentPanel">
                <Panel>
                    <TextBlock Text="Search, then select an item to see its details" IsVisible="{Binding !HasSelection}" Classes="DetailsEmpty"/>

                    <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HasSelection}">
                        <!-- Cover art, title and file. -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Classes="DetailsHeader">
                            <Border Grid.Column="0" Classes="CoverArt" IsVisible="{Binding HasCoverArt}">
                                <Image Source="{Binding CoverArt}" Classes="CoverArt"/>
                            </Border>
                            <StackPanel Grid.Column="1" Classes="DetailsHeading">
                                <SelectableTextBlock Text="{Binding DetailsTitle}" Classes="DetailsTitle"/>
                                <TextBlock Text="{Binding DetailsSubtitle}" Classes="DetailsSubtitle"/>
                                <TextBlock Text="{Binding FileText}" Classes="DetailsFile"/>
                            </StackPanel>
                        </Grid>

                        <!-- Play: the row, or everything under the selected branch, in order. -->
                        <StackPanel Grid.Row="1" Classes="PlayActions">
                            <Button Command="{Binding PlayCommand}" Classes="PlayAction accent"
                                    ToolTip.Tip="Play it (or everything in it, in order): VLC for movies and TV, Windows Media Player for music">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource play_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Play"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayFromHereCommand}" IsVisible="{Binding CanPlayFromHere}" Classes="PlayAction"
                                    ToolTip.Tip="Play this one and the rest of its season or album">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource play_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Play from here"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShuffleCommand}" Classes="PlayAction" ToolTip.Tip="Play everything in it in a random order">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource shuffle_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Shuffle"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EnqueueCommand}" Classes="PlayAction" ToolTip.Tip="Add it to the playlist of the VLC that is already playing">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource enqueue_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Add to VLC playlist"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" Classes="Details">
                            <StackPanel Classes="DetailsContent">
                                <!-- Read-only details. -->
                                <ItemsControl ItemsSource="{Binding DetailRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DetailRow">
                                            <Grid ColumnDefinitions="130,*" Classes="DetailRow">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="DetailLabel"/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="DetailValue"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Editable fields. -->
                                <StackPanel IsVisible="{Binding HasEditor}" Classes="Editor">
                                    <TextBlock Text="Edit" Classes="SectionHeading"/>
                                    <CheckBox Content="Favourite" IsChecked="{Binding Editor.IsFavourite, FallbackValue=False}"/>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow">
                                        <Label Grid.Column="0" Content="Description" Classes="EditLabel"/>
                                        <TextBox Grid.Column="1" Text="{Binding Editor.Description}" Classes="Description"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow">
                                        <Label Grid.Column="0" Content="Notes" Classes="EditLabel"/>
                                        <TextBox Grid.Column="1" Text="{Binding Editor.Notes}" Classes="Notes"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow" IsVisible="{Binding Editor.HasType, FallbackValue=False}">
                                        <Label Grid.Column="0" Content="{Binding Editor.TypeLabel, FallbackValue=''}" Classes="EditLabel"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Editor.TypeOptions}" SelectedItem="{Binding Editor.SelectedType}" Classes="Type"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow" IsVisible="{Binding Editor.HasMusicBrainzId, FallbackValue=False}">
                                        <Label Grid.Column="0" Content="MusicBrainz id" Classes="EditLabel"/>
                                        <TextBox Grid.Column="1" Text="{Binding Editor.MusicBrainzId}" Classes="MusicBrainzId"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow" IsVisible="{Binding Editor.HasLength, FallbackValue=False}">
                                        <Label Grid.Column="0" Content="Length" Classes="EditLabel"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding Editor.Length}" Minimum="0" FormatString="0" Classes="Length"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" Classes="EditRow" IsVisible="{Binding Editor.HasReleaseDate, FallbackValue=False}">
                                        <Label Grid.Column="0" Content="Release date" Classes="EditLabel"/>
                                        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Editor.ReleaseDate}" Classes="ReleaseDate"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions. -->
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Classes="DetailsActions">
                            <Button Grid.Column="0" Command="{Binding OpenFolderCommand}" Classes="DetailsAction" ToolTip.Tip="Open the folder (and select the file)">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource folder_open}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="CopyPathButton_OnClick" Classes="DetailsAction" ToolTip.Tip="Copy the file's (or folder's) path"
                                    IsEnabled="{Binding SelectedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource copy_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Copy path"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding RenameItemCommand}" Classes="DetailsAction" ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="Rename it on disk and in the database together (save or discard your changes first)">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource rename_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Rename..."/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Command="{Binding DiscardChangesCommand}" Content="Discard" Classes="DialogAction" IsVisible="{Binding HasEditor}"/>
                            <Button Grid.Column="5" Command="{Binding SaveChangesCommand}" Classes="DialogAction accent" IsVisible="{Binding HasEditor}">
                                <StackPanel Classes="ButtonContent">
                                    <PathIcon Data="{StaticResource save_icon}" Classes="ButtonIcon"/>
                                    <TextBlock Text="Save Changes"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Panel>
            </Border>
        </Grid>

        <!-- Rename (over the tab). -->
        <!-- ============================================================================================================== -->
        <Border IsVisible="{Binding HasRename}" Classes="ConfirmationOverlay">
            <Border Classes="ConfirmationCard RenameCard" DataContext="{Binding Rename}" x:DataType="vm:MediaRenameViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Classes="RenameContent">
                    <StackPanel Grid.Row="0" Classes="RenameHeading">
                        <TextBlock Text="{Binding Title}" Classes="ConfirmationTitle"/>
                        <TextBlock Text="{Binding CurrentName, StringFormat='Now: {0}'}" Classes="RenameCurrent"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Classes="RenameNameRow">
                        <TextBox Grid.Column="0" Text="{Binding NewName}" Classes="RenameName"/>
                        <Button Grid.Column="1" Command="{Binding TidyCommand}" Classes="DetailsAction"
                                ToolTip.Tip="Suggest a tidy name (Plex naming for movies and TV; technical tags removed for music)">
                            <StackPanel Classes="ButtonContent">
                                <PathIcon Data="{StaticResource tidy_icon}" Classes="ButtonIcon"/>
                                <TextBlock Text="Tidy name"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding NameHint}" Classes="RenameHint"/>
                    <StackPanel Grid.Row="3" Classes="RenameOptions">
                        <CheckBox Content="{Binding FolderOptionText}" IsChecked="{Binding RenameFolder}" IsVisible="{Binding HasFolderOption}"/>
                        <CheckBox Content="{Binding FilesOptionText}" IsChecked="{Binding RenameFiles}" IsVisible="{Binding HasFilesOption}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="4" Classes="RenamePreview">
                        <StackPanel Classes="RenamePreview">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Classes="Searching"/>
                            <TextBlock Text="{Binding ResultText}" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Classes="RenameProblem"/>
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="RenameProblem"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="RenameWarning"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="On disk (files first, then folders)" IsVisible="{Binding HasPlan}" Classes="RenameSection"/>
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="scanner:MediaRenameStep">
                                        <Grid ColumnDefinitions="60,*" Classes="RenameStep" ToolTip.Tip="{Binding To}">
                                            <TextBlock Grid.Column="0" Text="{Binding Kind}" Classes="RenameStepKind"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FromName}" Classes="RenameFrom"/>
                                                <TextBlock Text="{Binding ToName, StringFormat='→ {0}'}" Classes="RenameTo"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="In the database" IsVisible="{Binding HasPlan}" Classes="RenameSection"/>
                            <ItemsControl ItemsSource="{Binding DatabaseChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="RenameDatabase"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="5" Classes="ConfirmationActions">
                        <Button Command="{Binding CloseCommand}" Content="Cancel" Classes="DialogAction"/>
                        <Button Command="{Binding ApplyCommand}" Classes="DialogAction accent">
                            <StackPanel Classes="ButtonContent">
                                <PathIcon Data="{StaticResource rename_icon}" Classes="ButtonIcon"/>
                                <TextBlock Text="Apply"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Tidy names (over the tab). -->
        <!-- ============================================================================================================== -->
        <Border IsVisible="{Binding HasTidyNames}" Classes="ConfirmationOverlay">
            <Border Classes="ConfirmationCard TidyCard" DataContext="{Binding TidyNames}" x:DataType="vm:TidyNamesViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Classes="RenameContent">
                    <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="ConfirmationTitle"/>
                    <CheckBox Grid.Row="1" Content="Rename movie and episode files with their folders" IsChecked="{Binding RenameFiles}" IsEnabled="{Binding !IsBusy}"/>
                    <Grid Grid.Row="2" ColumnDefinitions="32,70,*,*,180" Classes="TidyHeader">
                        <TextBlock Grid.Column="1" Text="Kind"/>
                        <TextBlock Grid.Column="2" Text="Now"/>
                        <TextBlock Grid.Column="3" Text="Tidy name (edit if you like)"/>
                        <TextBlock Grid.Column="4" Text="Check / result"/>
                    </Grid>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" Classes="TidyRows">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TidyRow">
                                <Grid ColumnDefinitions="32,70,*,*,180" Classes="TidyRow">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="TidyKind"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentName}" ToolTip.Tip="{Binding CurrentName}" Classes="TidyCurrent"/>
                                    <TextBox Grid.Column="3" Text="{Binding NewName}" Classes="TidyNew"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Message}" ToolTip.Tip="{Binding Message}" Classes="TidyMessage"
                                               Classes.Problem="{Binding IsProblem}" Classes.Failed="{Binding IsFailed}" Classes.Done="{Binding IsDone}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" Classes="TidyProgress">
                        <ProgressBar Grid.Row="0" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}" IsVisible="{Binding IsBusy}" Classes="Searching"/>
                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="SearchStatusText"/>
                    </Grid>
                    <StackPanel Grid.Row="5" Classes="ConfirmationActions">
                        <Button Command="{Binding ApplyCancelCommand}" Content="Stop" Classes="DialogAction" IsVisible="{Binding IsBusy}"/>
                        <Button Command="{Binding CloseCommand}" Content="Close" Classes="DialogAction"/>
                        <Button Command="{Binding ApplyCommand}" Classes="DialogAction accent">
                            <StackPanel Classes="ButtonContent">
                                <PathIcon Data="{StaticResource tidy_icon}" Classes="ButtonIcon"/>
                                <TextBlock Text="Rename ticked"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- A question over the tab (unsaved changes). -->
        <!-- ============================================================================================================== -->
        <Border IsVisible="{Binding HasConfirmation}" Classes="ConfirmationOverlay">
            <Border Classes="ConfirmationCard">
                <StackPanel Classes="ConfirmationContent">
                    <TextBlock Text="{Binding Confirmation.Title, FallbackValue=''}" Classes="ConfirmationTitle"/>
                    <TextBlock Text="{Binding Confirmation.Message, FallbackValue=''}" Classes="ConfirmationMessage"/>
                    <StackPanel Classes="ConfirmationActions">
                        <Button Command="{Binding DismissConfirmationCommand}" Content="{Binding Confirmation.BackText, FallbackValue=''}" Classes="DialogAction"/>
                        <Button Command="{Binding ConfirmCommand}" Content="{Binding Confirmation.ConfirmText, FallbackValue=''}" Classes="DialogAction accent"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
