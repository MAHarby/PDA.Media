<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDA.Media.Utils.ViewModels"
             xmlns:models="using:PDA.Media.Utils.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PDA.Media.Utils.Views.EncoderProfileView"
             x:DataType="vm:EncoderProfilesViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="save_icon">M433.1 129.1l-83.9-83.9C339.7 35.7 326.9 30.5 313.6 30.5L64 30.5C28.7 30.5 0 59.2 0 94.5l0 323c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-224c0-13.3-5.2-26.1-14.6-35.5zM128 80l160 0 0 80-160 0 0-80zm256 352L128 432l0-144 256 0 0 144z</StreamGeometry>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Form Header & Quick Save -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="{Binding EditingProfile.Name, FallbackValue='Select a profile'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>
                <TextBlock Text="Modify transcoding parameters below and click Save Profile" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Revert" Command="{Binding RevertChangesCommand}" ToolTip.Tip="Revert unsaved changes" Padding="12,6"/>
                <Button Background="{DynamicResource SystemAccentColor}" Foreground="White" FontWeight="Bold" Command="{Binding SaveProfileCommand}" ToolTip.Tip="Save changes to this profile" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource save_icon}" Width="12" Height="12" Foreground="White"/>
                        <TextBlock Text="Save Profile" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable Form Fields -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" IsVisible="{Binding EditingProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                
                <!-- Section 1: General Profile Info -->
                <Border Background="{DynamicResource SystemChromeMediumLowColor}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0.5">
                    <StackPanel Spacing="8">
                        <TextBlock Text="General Information" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <Grid ColumnDefinitions="*,180,120,180" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="Profile Name:" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EditingProfile.Name, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="Target Category:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding TargetCategories}" SelectedItem="{Binding EditingProfile.TargetCategory, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,0">
                                <Label Content="Container:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding ContainerFormats}" SelectedItem="{Binding EditingProfile.ContainerFormat, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Label Content="Min Source Size:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EditingProfile.MinimumSourceFileSizeFormatted, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditingProfile.MinimumSourceFileSize, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,4,0,0">
                            <Label Content="Description:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditingProfile.Description, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Video Settings -->
                <Border Background="{DynamicResource SystemChromeMediumLowColor}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0.5">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Video Settings (MKV Transcoding)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                <Label Content="Video Codec:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding EditingProfile.VideoCodec, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,8">
                                <Label Content="Encoder Preset / Speed:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding EditingProfile.Preset, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                <Label Content="Pixel Format:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding PixelFormats}" SelectedItem="{Binding EditingProfile.PixelFormat, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="Resolution / Scale:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding EditingProfile.Resolution, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="Frame Rate (FPS):" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding EditingProfile.FrameRate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <Label Content="Hardware Acceleration:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding HardwareAccelerations}" SelectedItem="{Binding EditingProfile.HardwareAcceleration, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <!-- CRF Slider with Value Indicator -->
                        <Border Background="{DynamicResource SystemChromeLowColor}" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Label Content="Constant Rate Factor (CRF):" FontWeight="SemiBold"/>
                                    <TextBlock Text="Lower values = higher quality (18-28 standard for x265)" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditingProfile.Crf}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="51" Value="{Binding EditingProfile.Crf, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 3: Audio Settings -->
                <Border Background="{DynamicResource SystemChromeMediumLowColor}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0.5">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Audio Settings" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="Audio Codec:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding EditingProfile.AudioCodec, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="Audio Bitrate:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding EditingProfile.AudioBitrate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <Label Content="Channels:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AudioChannelsList}" SelectedItem="{Binding EditingProfile.AudioChannels, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <Label Content="Sample Rate:" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AudioSampleRates}" SelectedItem="{Binding EditingProfile.AudioSampleRate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Stream Options & Custom Arguments -->
                <Border Background="{DynamicResource SystemChromeMediumLowColor}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0.5">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Container &amp; Subtitle Options" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>

                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox Content="Preserve All Streams / Tracks (-map 0)" IsChecked="{Binding EditingProfile.KeepAllStreams, Mode=TwoWay}"/>
                            <CheckBox Content="Copy Subtitles (-c:s copy)" IsChecked="{Binding EditingProfile.CopySubtitles, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0">
                            <Label Content="Custom FFMpeg Arguments (Appended to command):" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditingProfile.CustomArguments, Mode=TwoWay}" PlaceholderText="-tune animation -maxrate 8M -bufsize 16M"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Real-time Generated FFMpeg Command Preview -->
                <Border Background="{DynamicResource SystemChromeMediumLowColor}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0.5">
                    <StackPanel Spacing="6">
                        <TextBlock Text="FFMpeg Command Preview" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SystemAccentColor}"/>
                        <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                            <SelectableTextBlock Text="{Binding EditingProfile.GeneratedFFMpegArguments}"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 FontSize="12"
                                                 Foreground="#A9DC76"
                                                 TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Feedback Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
