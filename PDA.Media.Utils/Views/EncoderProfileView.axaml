<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDA.Media.Utils.ViewModels"
             xmlns:models="using:PDA.Media.Utils.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PDA.Media.Utils.Views.EncoderProfileView"
             x:DataType="vm:EncoderProfilesViewModel">

    <UserControl.Styles>

        <!-- Icon Buttons (icon + text content). Same as EncoderProfilesView. -->
        <!-- ====================================================================================================== -->
        <Style Selector="StackPanel.ButtonContent">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="PathIcon.ButtonIcon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>


        <!-- Editor Header. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.EditorHeader">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="StackPanel.EditorHeaderText">
            <Setter Property="Orientation" Value="Vertical"/>
        </Style>
        <Style Selector="TextBlock.EditorTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
        </Style>
        <Style Selector="TextBlock.EditorSubtitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="StackPanel.EditorActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="Button.EditorAction">
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.PrimaryAction">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>

            <!-- Set on the content so it stays white when the theme changes the button's foreground on hover.
                 Scoped to ButtonContent: a plain "^ TextBlock" would also turn the tooltip text white. -->
            <Style Selector="^ StackPanel.ButtonContent > PathIcon">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="^ StackPanel.ButtonContent > TextBlock">
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Style>


        <!-- Form Sections. -->
        <!-- ====================================================================================================== -->
        <Style Selector="StackPanel.EditorSections">
            <Setter Property="Spacing" Value="14"/>
        </Style>
        <Style Selector="Border.EditorSection">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>
        <Style Selector="StackPanel.SectionContent">
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <Style Selector="StackPanel.GeneralInfoContent">
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="StackPanel.CommandPreviewContent">
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle.Small">
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- Form Fields. -->
        <!-- ====================================================================================================== -->
        <!-- Fields sit in grid columns; the right margin is the gap to the next column. -->
        <Style Selector="StackPanel.FormField">
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style Selector="StackPanel.FormField.LastColumn">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="StackPanel.FullWidthField">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="Grid.FieldRows">
            <Setter Property="RowSpacing" Value="8"/>
        </Style>
        <Style Selector="Label.FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="StackPanel.FieldLabelRow">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="TextBlock.FieldHint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.FieldInput">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="StackPanel.OptionToggles">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="24"/>
        </Style>


        <!-- CRF Slider Panel. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.CrfPanel">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="StackPanel.CrfLabelRow">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="TextBlock.CrfHint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.CrfValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <!-- FFMpeg Command Preview. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.CommandPreview">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="SelectableTextBlock.CommandPreview">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A9DC76"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>


        <!-- Status Bar. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.StatusBar">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="TextBlock.StatusMessage">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Form Header & Quick Save -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Classes="EditorHeader">
            <StackPanel Grid.Column="0" Classes="EditorHeaderText">
                <TextBlock Text="{Binding EditingProfile.Name, FallbackValue='Select a profile'}" Classes="EditorTitle"/>
                <TextBlock Text="Modify transcoding parameters below and click Save Profile" Classes="EditorSubtitle"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Classes="EditorActions">
                <Button Content="Revert" Command="{Binding RevertChangesCommand}" ToolTip.Tip="Revert unsaved changes" Classes="EditorAction"/>
                <Button Command="{Binding SaveProfileCommand}" ToolTip.Tip="Save changes to this profile" Classes="PrimaryAction">
                    <StackPanel Classes="ButtonContent">
                        <PathIcon Data="{StaticResource save_icon}" Classes="ButtonIcon"/>
                        <TextBlock Text="Save Profile"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable Form Fields -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel IsVisible="{Binding EditingProfile, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="EditorSections">

                <!-- Section 1: General Profile Info -->
                <Border Classes="EditorSection">
                    <StackPanel Classes="GeneralInfoContent">
                        <TextBlock Text="General Information" Classes="SectionTitle"/>

                        <Grid ColumnDefinitions="*,180,120,180" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Classes="FormField">
                                <Label Content="Profile Name:" Classes="FieldLabel"/>
                                <TextBox Text="{Binding EditingProfile.Name, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Classes="FormField">
                                <Label Content="Target Category:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding TargetCategories}" SelectedItem="{Binding EditingProfile.TargetCategory, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Classes="FormField">
                                <Label Content="Container:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding ContainerFormats}" SelectedItem="{Binding EditingProfile.ContainerFormat, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Classes="FormField LastColumn">
                                <StackPanel Classes="FieldLabelRow">
                                    <Label Content="Min Source Size:" Classes="FieldLabel"/>
                                    <TextBlock Text="{Binding EditingProfile.MinimumSourceFileSizeFormatted, StringFormat='({0})'}" Classes="FieldHint"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditingProfile.MinimumSourceFileSize, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Classes="FullWidthField">
                            <Label Content="Description:" Classes="FieldLabel"/>
                            <TextBox Text="{Binding EditingProfile.Description, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Video Settings -->
                <Border Classes="EditorSection">
                    <StackPanel Classes="SectionContent">
                        <TextBlock Text="Video Settings (MKV Transcoding)" Classes="SectionTitle"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Classes="FieldRows">
                            <StackPanel Grid.Column="0" Classes="FormField">
                                <Label Content="Video Codec:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding EditingProfile.VideoCodec, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Classes="FormField">
                                <Label Content="Encoder Preset / Speed:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding EditingProfile.Preset, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Classes="FormField LastColumn">
                                <Label Content="Pixel Format:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding PixelFormats}" SelectedItem="{Binding EditingProfile.PixelFormat, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Classes="FormField">
                                <Label Content="Resolution / Scale:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding EditingProfile.Resolution, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Classes="FormField">
                                <Label Content="Frame Rate (FPS):" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding EditingProfile.FrameRate, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Classes="FormField LastColumn">
                                <Label Content="Hardware Acceleration:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding HardwareAccelerations}" SelectedItem="{Binding EditingProfile.HardwareAcceleration, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- CRF Slider with Value Indicator -->
                        <Border Classes="CrfPanel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Classes="CrfLabelRow">
                                    <Label Content="Constant Rate Factor (CRF):" Classes="FieldLabel"/>
                                    <TextBlock Text="Lower values = higher quality (18-28 standard for x265)" Classes="CrfHint"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditingProfile.Crf}" Classes="CrfValue"/>
                                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="51" Value="{Binding EditingProfile.Crf, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 3: Audio Settings -->
                <Border Classes="EditorSection">
                    <StackPanel Classes="SectionContent">
                        <TextBlock Text="Audio Settings" Classes="SectionTitle"/>

                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0" Classes="FormField">
                                <Label Content="Audio Codec:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding EditingProfile.AudioCodec, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Classes="FormField">
                                <Label Content="Audio Bitrate:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding EditingProfile.AudioBitrate, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Classes="FormField">
                                <Label Content="Channels:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding AudioChannelsList}" SelectedItem="{Binding EditingProfile.AudioChannels, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Classes="FormField LastColumn">
                                <Label Content="Sample Rate:" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding AudioSampleRates}" SelectedItem="{Binding EditingProfile.AudioSampleRate, Mode=TwoWay}" Classes="FieldInput"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Stream Options & Custom Arguments -->
                <Border Classes="EditorSection">
                    <StackPanel Classes="SectionContent">
                        <TextBlock Text="Container &amp; Subtitle Options" Classes="SectionTitle"/>

                        <StackPanel Classes="OptionToggles">
                            <CheckBox Content="Preserve All Streams / Tracks (-map 0)" IsChecked="{Binding EditingProfile.KeepAllStreams, Mode=TwoWay}"/>
                            <CheckBox Content="Copy Subtitles (-c:s copy)" IsChecked="{Binding EditingProfile.CopySubtitles, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Classes="FullWidthField">
                            <Label Content="Custom FFMpeg Arguments (Appended to command):" Classes="FieldLabel"/>
                            <TextBox Text="{Binding EditingProfile.CustomArguments, Mode=TwoWay}" PlaceholderText="-tune animation -maxrate 8M -bufsize 16M"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Real-time Generated FFMpeg Command Preview -->
                <Border Classes="EditorSection">
                    <StackPanel Classes="CommandPreviewContent">
                        <TextBlock Text="FFMpeg Command Preview" Classes="SectionTitle Small"/>
                        <Border Classes="CommandPreview">
                            <SelectableTextBlock Text="{Binding EditingProfile.GeneratedFFMpegArguments}" Classes="CommandPreview"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Feedback Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Classes="StatusBar">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="StatusMessage"/>
        </Grid>
    </Grid>
</UserControl>
