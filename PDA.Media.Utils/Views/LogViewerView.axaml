<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDA.Media.Utils.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen"
        x:Class="PDA.Media.Utils.Views.LogViewerView"
        x:DataType="vm:LogViewerViewModel"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="Inter" FontSize="13"
        Title="Log Viewer">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Application Log" FontSize="18" FontWeight="SemiBold"/>
            <SelectableTextBlock Text="{Binding LogFilePath}" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
        </StackPanel>

        <!-- Log contents -->
        <TextBox Grid.Row="1" Name="LogTextBox" Text="{Binding LogText}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 Background="#1E1E1E" Foreground="#D4D4D4" CornerRadius="3"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="20,7" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Close" Click="CloseButton_OnClick" Padding="20,7"/>
        </Grid>

    </Grid>
</Window>
