<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDA.Media.Utils.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        Width="1150" Height="800"
        WindowStartupLocation="CenterScreen"
        x:Class="PDA.Media.Utils.Views.ColoursView"
        x:DataType="vm:ColoursViewModel"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="Inter" FontSize="13"
        Title="Avalonia Fluent Theme Colors">

    <Design.DataContext>
        <vm:ColoursViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- Top Toolbar / Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,14"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <!-- Title & Count -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Fluent Theme Colors" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>
                    <TextBlock Text="{Binding DisplayedColors.Count, StringFormat='Showing {0} color definitions'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </StackPanel>

                <!-- Search Input -->
                <TextBox Grid.Column="1"
                         PlaceholderText="Search color name, category, or hex..."
                         Text="{Binding SearchText, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         MaxWidth="400"
                         HorizontalAlignment="Left"
                         Width="350"/>

                <!-- Category Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Width="140"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Theme Mode Toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Name="ThemeVariantComboBox"
                              ItemsSource="{Binding ThemeVariantNames}"
                              SelectedItem="{Binding SelectedThemeVariantName, Mode=TwoWay}"
                              SelectionChanged="OnThemeVariantSelectionChanged"
                              Width="110"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Color Palette Grid / List -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DisplayedColors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FluentColorItem">
                        <Border Width="340"
                                Margin="6"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SystemChromeLowColor}"
                                BorderBrush="{DynamicResource SystemChromeHighColor}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto">
                                <!-- Color Name and Category -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemBaseHighColor}"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SystemChromeMediumColor}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Category}" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                                    </Border>
                                </Grid>

                                <!-- Swatches: Light and Dark side-by-side -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,4,0,0">
                                    <!-- Light Variant Box -->
                                    <Border Grid.Column="0"
                                            Margin="0,0,5,0"
                                            Padding="8"
                                            Background="#FFFFFF"
                                            CornerRadius="6"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="Light" FontSize="11" FontWeight="Bold" Foreground="#222222" HorizontalAlignment="Center"/>
                                            <Border Width="60"
                                                    Height="36"
                                                    CornerRadius="4"
                                                    Background="{Binding LightBrush}"
                                                    BorderBrush="#888888"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="{Binding LightHex}"/>
                                            <SelectableTextBlock Text="{Binding LightHex}" 
                                                                 FontSize="11" 
                                                                 FontFamily="Consolas,Menlo,monospace"
                                                                 Foreground="#333333" 
                                                                 HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Dark Variant Box -->
                                    <Border Grid.Column="1"
                                            Margin="5,0,0,0"
                                            Padding="8"
                                            Background="#1E1E1E"
                                            CornerRadius="6"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="Dark" FontSize="11" FontWeight="Bold" Foreground="#EEEEEE" HorizontalAlignment="Center"/>
                                            <Border Width="60"
                                                    Height="36"
                                                    CornerRadius="4"
                                                    Background="{Binding DarkBrush}"
                                                    BorderBrush="#888888"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="{Binding DarkHex}"/>
                                            <SelectableTextBlock Text="{Binding DarkHex}" 
                                                                 FontSize="11" 
                                                                 FontFamily="Consolas,Menlo,monospace"
                                                                 Foreground="#CCCCCC" 
                                                                 HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
