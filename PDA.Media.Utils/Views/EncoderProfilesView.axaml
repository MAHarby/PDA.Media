<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDA.Media.Utils.ViewModels"
        xmlns:models="using:PDA.Media.Utils.Models"
        xmlns:views="using:PDA.Media.Utils.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        Width="1150" Height="800"
        WindowStartupLocation="CenterScreen"
        x:Class="PDA.Media.Utils.Views.EncoderProfilesView"
        x:DataType="vm:EncoderProfilesViewModel"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="Inter" FontSize="13"
        Title="FFMpegCore Encoding Profiles">

    <Design.DataContext>
        <vm:EncoderProfilesViewModel />
    </Design.DataContext>

    <Window.Resources>
        <StreamGeometry x:Key="plus_icon">M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 144L48 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l144 0 0 144c0 17.7 14.3 32 32 32s32-14.3 32-32l0-144 144 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-144 0 0-144z</StreamGeometry>
        <StreamGeometry x:Key="trash_icon">M135.2 17.7L128 32 32 32C14.3 32 0 46.3 0 64S14.3 96 32 96l384 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-96 0-7.2-14.3C307.4 6.8 296.3 0 284.2 0L163.8 0c-12.1 0-23.2 6.8-28.6 17.7zM416 128L32 128 53.2 467c1.6 25.3 22.6 45 47.9 45l245.8 0c25.3 0 46.3-19.7 47.9-45L416 128z</StreamGeometry>
        <StreamGeometry x:Key="copy_icon">M0 224c0-35.3 28.7-64 64-64l192 0c35.3 0 64 28.7 64 64l0 224c0 35.3-28.7 64-64 64L64 512c-35.3 0-64-28.7-64-64L0 224zM320 96c0-17.7 14.3-32 32-32l32 0c53 0 96 43 96 96l0 224c0 17.7-14.3 32-32 32s-32-14.3-32-32l0-224c0-17.7-14.3-32-32-32l-32 0c-17.7 0-32-14.3-32-32z</StreamGeometry>
        <StreamGeometry x:Key="reset_icon">M463.5 224l8.5 0c13.3 0 24-10.7 24-24l0-128c0-9.7-5.8-18.5-14.8-22.2s-19.3-1.7-26.2 5.2L413.4 96.6C368.6 57.9 310.8 32 248 32 119 32 14.4 134.6 3.2 262.6 2 276.1 12.6 288 26.2 288l48.2 0c12.4 0 22.8-9.4 24-21.8C107.5 174.5 170.8 112 248 112c43.4 0 83.1 16.9 113.1 44.5L319.4 198.2c-6.9 6.9-8.9 17.2-5.2 26.2s12.5 14.8 22.2 14.8l127.1 0zM48 288c-13.3 0-24 10.7-24 24l0 128c0 9.7 5.8 18.5 14.8 22.2s19.3 1.7 26.2-5.2L106.6 415.4C151.4 454.1 209.2 480 272 480c129 0 233.6-102.6 244.8-230.6 1.2-13.5-9.4-25.4-23-25.4l-48.2 0c-12.4 0-22.8 9.4-24 21.8C412.5 337.5 349.2 400 272 400c-43.4 0-83.1-16.9-113.1-44.5L200.6 313.8c6.9-6.9 8.9-17.2 5.2-26.2s-12.5-14.8-22.2-14.8L48 288z</StreamGeometry>
        <StreamGeometry x:Key="save_icon">M433.1 129.1l-83.9-83.9C339.7 35.7 326.9 30.5 313.6 30.5L64 30.5C28.7 30.5 0 59.2 0 94.5l0 323c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-224c0-13.3-5.2-26.1-14.6-35.5zM128 80l160 0 0 80-160 0 0-80zm256 352L128 432l0-144 256 0 0 144z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,14"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="FFMpegCore Transcoding Profiles" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>
                    <TextBlock Text="Configure and tune video/audio presets for MKV movies and TV shows" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" ToolTip.Tip="Reset all profiles to built-in defaults" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource reset_icon}" Width="12" Height="12"/>
                            <TextBlock Text="Reset Defaults"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Master (Left) - Details (Right) -->
        <Grid Grid.Row="1" ColumnDefinitions="320,12,*">
            
            <!-- Left Pane: Profile List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemChromeLowColor}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="1"
                    Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- Search Input -->
                    <TextBox Grid.Row="0"
                             PlaceholderText="Search profiles..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Margin="0,0,0,8"/>

                    <!-- List Action Toolbar -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                        <Button Grid.Column="0" Command="{Binding AddProfileCommand}" ToolTip.Tip="Add New Profile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource plus_icon}" Width="11" Height="11"/>
                                <TextBlock Text="Add"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding DuplicateProfileCommand}" ToolTip.Tip="Duplicate Selected Profile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0" IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource copy_icon}" Width="11" Height="11"/>
                                <TextBlock Text="Clone"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding DeleteProfileCommand}" ToolTip.Tip="Delete Selected Profile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0" IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource trash_icon}" Width="11" Height="11"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Profiles ListBox -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EncodeProfile">
                                <Border Padding="8,6" Margin="0,2">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Profile Name + Predefined Badge -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemBaseHighColor}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource SystemAccentColor}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding TargetCategory}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Summary Specs -->
                                        <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource SystemBaseMediumHighColor}" Margin="0,3,0,0">
                                            <Run Text="{Binding VideoCodec}"/>
                                            <Run Text=" | CRF: "/><Run Text="{Binding Crf}"/>
                                            <Run Text=" | Min: "/><Run Text="{Binding MinimumSourceFileSizeFormatted}"/>
                                            <Run Text=" | Audio: "/><Run Text="{Binding AudioCodec}"/>
                                        </TextBlock>

                                        <!-- Short Description -->
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profile Count -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding FilteredProfiles.Count, StringFormat='Total profiles: {0}'}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Margin="4,8,0,0"/>
                </Grid>
            </Border>

            <!-- Right Pane: Profile Editor Form (EncoderProfileView UserControl) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemChromeLowColor}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="1"
                    Padding="16">
                <views:EncoderProfileView />
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Settings stored in app profile directory." FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Close" Click="CloseButton_OnClick" Padding="20,7"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
