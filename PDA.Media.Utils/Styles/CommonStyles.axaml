<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

        <!-- Shared by every view; included once in App.axaml. View style files can override these. -->

        <!-- Window Layout. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.WindowContent">
            <Setter Property="Margin" Value="16"/>
        </Style>


        <!-- Dialog Buttons (Close, Refresh, ... in a window's footer). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Button.DialogAction">
            <Setter Property="Padding" Value="20,7"/>
        </Style>


        <!-- Icon Buttons (icon + text content). -->
        <!-- ====================================================================================================== -->
        <Style Selector="StackPanel.ButtonContent">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="PathIcon.ButtonIcon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>


        <!-- Profile Tag (category badge). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.ProfileTag">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.ProfileTag">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>


        <!-- Header Panel (a window's heading: title, subtitle and actions). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.HeaderPanel">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.HeaderText">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.HeaderTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
        </Style>
        <Style Selector="TextBlock.HeaderSubtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="StackPanel.HeaderActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.HeaderAction">
            <Setter Property="Padding" Value="10,6"/>
        </Style>


        <!-- Content Panel (a rounded panel in a window, like the profile list and editor). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.ContentPanel">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>


        <!-- Footer Bar (a window's bottom row: info on the left, actions on the right). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.FooterBar">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style Selector="StackPanel.FooterInfo">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.FooterText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="StackPanel.FooterActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
        </Style>


        <!-- Log Lists (console look: the main window's Audit Log and the media scanner's activity log). -->
        <!-- ====================================================================================================== -->
        <Style Selector="ListBox.AuditLog">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ListBox.AuditLog ListBoxItem">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBlock.AuditLogEntry">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.AuditLogEntry.Warning">
            <Setter Property="Foreground" Value="#E5C07B"/>
        </Style>
        <Style Selector="TextBlock.AuditLogEntry.Error">
            <Setter Property="Foreground" Value="#F44747"/>
        </Style>

</Styles>
