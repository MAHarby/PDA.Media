<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

        <!-- Layout. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.SearchContent">
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>


        <!-- Search Bar, Categories and Filters. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.SearchBar">
            <Setter Property="ColumnSpacing" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.SearchButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ItemsControl.SearchCategories">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="CheckBox.SearchCategory">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="StackPanel.SearchFilters">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>


        <!-- Results Tree. -->
        <!-- ====================================================================================================== -->
        <Style Selector="TextBlock.NodeTitle.Match">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="TextBlock.NodeSubtitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="PathIcon.Favourite">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Foreground" Value="#E5B53B"/>
        </Style>
        <Style Selector="Grid.SearchStatus">
            <Setter Property="Margin" Value="2,8,0,0"/>
            <Setter Property="RowSpacing" Value="4"/>
        </Style>
        <Style Selector="ProgressBar.Searching">
            <Setter Property="MinHeight" Value="3"/>
        </Style>
        <Style Selector="TextBlock.SearchStatusText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>


        <!-- Details Panel. -->
        <!-- ====================================================================================================== -->
        <Style Selector="Grid.DetailsHeader">
            <Setter Property="ColumnSpacing" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.CoverArt">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Image.CoverArt">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Stretch" Value="UniformToFill"/>
        </Style>
        <Style Selector="TextBlock.DetailsFile">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="StackPanel.PlayActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Button.PlayAction">
            <Setter Property="Padding" Value="12,6"/>
        </Style>


        <!-- Editor. -->
        <!-- ====================================================================================================== -->
        <Style Selector="StackPanel.Editor">
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style Selector="Label.EditLabel">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBox.Description">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="56"/>
        </Style>
        <Style Selector="TextBox.Notes">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="110"/>
        </Style>
        <Style Selector="ComboBox.Type, NumericUpDown.Length, CalendarDatePicker.ReleaseDate">
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Grid.DetailsActions">
            <Setter Property="ColumnSpacing" Value="8"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Button.DetailsAction">
            <Setter Property="Padding" Value="10,6"/>
        </Style>


        <!-- Rename and Tidy Names Panels (over the tab; their card is the ConfirmationCard from MediaLibraryViewStyles, made larger). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.RenameCard">
            <Setter Property="MaxWidth" Value="760"/>
            <Setter Property="Width" Value="760"/>
            <Setter Property="MaxHeight" Value="600"/>
        </Style>
        <Style Selector="Border.TidyCard">
            <Setter Property="MaxWidth" Value="1060"/>
            <Setter Property="Width" Value="1060"/>
            <Setter Property="Height" Value="600"/>
        </Style>
        <Style Selector="Grid.RenameContent">
            <Setter Property="RowSpacing" Value="10"/>
        </Style>
        <Style Selector="StackPanel.RenameHeading">
            <Setter Property="Spacing" Value="2"/>
        </Style>
        <Style Selector="TextBlock.RenameCurrent, TextBlock.RenameHint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="Grid.RenameNameRow">
            <Setter Property="ColumnSpacing" Value="8"/>
        </Style>
        <Style Selector="TextBox.RenameName">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="StackPanel.RenameOptions">
            <Setter Property="Spacing" Value="2"/>
        </Style>
        <Style Selector="StackPanel.RenamePreview">
            <Setter Property="Spacing" Value="4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style Selector="TextBlock.RenameSection">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="TextBlock.RenameProblem">
            <Setter Property="Foreground" Value="#D9534F"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.RenameWarning">
            <Setter Property="Foreground" Value="#D19A2E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Grid.RenameStep">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="TextBlock.RenameStepKind">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBlock.RenameFrom">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.RenameTo">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.RenameDatabase">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Grid.TidyHeader > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="Grid.TidyHeader, Grid.TidyRow">
            <Setter Property="ColumnSpacing" Value="8"/>
        </Style>
        <Style Selector="ListBox.TidyRows">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox.TidyRows ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style Selector="TextBlock.TidyKind, TextBlock.TidyCurrent, TextBlock.TidyMessage">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.TidyKind">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBlock.TidyMessage">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.TidyMessage.Problem, TextBlock.TidyMessage.Failed">
            <Setter Property="Foreground" Value="#D9534F"/>
        </Style>
        <Style Selector="TextBlock.TidyMessage.Done">
            <Setter Property="Foreground" Value="#4CAF50"/>
        </Style>
        <Style Selector="Grid.TidyProgress">
            <Setter Property="RowSpacing" Value="4"/>
        </Style>

</Styles>
