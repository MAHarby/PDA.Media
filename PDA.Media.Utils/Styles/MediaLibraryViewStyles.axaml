<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

        <!-- The Media Library Services window. Its heading, panels and footer use CommonStyles (HeaderPanel, ContentPanel, FooterBar);
             the styles here also apply inside its tabs (MediaSearchView, MediaAnalysisView, MediaScannerView). -->

        <!-- Heading. -->
        <!-- ====================================================================================================== -->
        <Style Selector="TextBlock.HeaderInfo">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <!-- Tabs. -->
        <!-- ====================================================================================================== -->
        <Style Selector="TabControl.LibraryTabs">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl.LibraryTabs TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style Selector="StackPanel.TabHeader">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="PathIcon.TabIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>


        <!-- Section Headings (in both tabs' panels). -->
        <!-- ====================================================================================================== -->
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.SectionActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="Button.SectionAction">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>


        <!-- Media Trees (the Search and Analysis tabs): an icon per kind of node. -->
        <!-- ====================================================================================================== -->
        <Style Selector="TreeView.MediaTree">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,4"/>
        </Style>
        <Style Selector="StackPanel.NodeContent">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Group">
            <Setter Property="Data" Value="{StaticResource library_icon}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Artist">
            <Setter Property="Data" Value="{StaticResource artist_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Album">
            <Setter Property="Data" Value="{StaticResource album_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Track">
            <Setter Property="Data" Value="{StaticResource music_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Source">
            <Setter Property="Data" Value="{StaticResource folder_open}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Movie">
            <Setter Property="Data" Value="{StaticResource film_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Show">
            <Setter Property="Data" Value="{StaticResource tv_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Season">
            <Setter Property="Data" Value="{StaticResource season_icon}"/>
        </Style>
        <Style Selector="PathIcon.NodeIcon.Episode">
            <Setter Property="Data" Value="{StaticResource film_icon}"/>
        </Style>
        <Style Selector="TextBlock.NodeTitle.Group">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.NodeTitle.Deleted">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
        <Style Selector="TextBlock.NodeTitle.Message">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>


        <!-- Details Panels (the Search and Analysis tabs). -->
        <!-- ====================================================================================================== -->
        <Style Selector="TextBlock.DetailsEmpty">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="StackPanel.DetailsHeading">
            <Setter Property="Spacing" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.DetailsTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.DetailsSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumHighColor}"/>
        </Style>
        <Style Selector="StackPanel.DetailsContent">
            <Setter Property="Spacing" Value="4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="Grid.DetailRow">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="TextBlock.DetailLabel">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="SelectableTextBlock.DetailValue">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>


        <!-- Confirmation (shown over a tab). -->
        <!-- ====================================================================================================== -->
        <Style Selector="Border.ConfirmationOverlay">
            <Setter Property="Background" Value="#80000000"/>
        </Style>
        <Style Selector="Border.ConfirmationCard">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.ConfirmationContent">
            <Setter Property="Spacing" Value="12"/>
        </Style>
        <Style Selector="TextBlock.ConfirmationTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.ConfirmationMessage">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="StackPanel.ConfirmationActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

</Styles>
