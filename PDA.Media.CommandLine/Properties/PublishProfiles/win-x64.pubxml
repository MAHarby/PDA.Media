<?xml version="1.0" encoding="utf-8"?>
<!-- pda-media as one self-contained file for win-x64 (no .NET install needed):
     dotnet publish PDA.Media.CommandLine -p:PublishProfile=win-x64   (output: PDA.Media.CommandLine/bin/publish/win-x64) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- No separate .pdb files from the referenced projects: the publish folder holds just the one file. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin/publish/win-x64/</PublishDir>
  </PropertyGroup>
</Project>
